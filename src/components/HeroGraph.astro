---
import SplitExperience from '../experiences/splitting/Experience.astro';
import EnergyExperience from '../experiences/energy/Experience.astro';
import WiringExperience from '../experiences/wiring/Experience.astro';
import { withBase } from '../lib/model.mjs';
import '../styles/experiences.css';
import '../styles/workbenches.css';
const link = (path: string) => withBase(import.meta.env.BASE_URL, path);
const panels = [
  { key: 'cad', label: '拆板工作台', slug: 'dwg-agent' },
  { key: 'energy', label: '气象与出力', slug: 'renewable-forecasting' },
  { key: 'wiring', label: '跨页追线', slug: 'electrical-drawings' },
];
---
<section class="home-workbench" data-home-workbench aria-label="动手了解三个项目">
  <div class="workbench-heading"><span class="mono"><i></i> PROJECT LAB</span><span>从核心操作开始</span></div>
  <div class="workbench-tabs" data-home-tabs role="tablist" aria-label="选择项目体验" hidden>{panels.map((panel, i) => <button type="button" id={`home-tab-${panel.key}`} data-home-tab={panel.key} role="tab" aria-controls={`home-panel-${panel.key}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1}>{panel.label}</button>)}</div>
  {panels.map(panel => <div id={`home-panel-${panel.key}`} data-home-panel={panel.key} role="tabpanel" aria-labelledby={`home-tab-${panel.key}`}>
    <noscript><h2 class="static-workbench-title">{panel.label}</h2></noscript>
    {panel.key === 'cad' && <SplitExperience compact />}
    {panel.key === 'energy' && <EnergyExperience compact />}
    {panel.key === 'wiring' && <WiringExperience compact />}
    <div class="workbench-footer"><span>独立重建样例 · 浏览器内计算</span><a class:list={['workbench-more', { 'node-cad': panel.key === 'cad', 'node-data': panel.key === 'energy', 'node-wiring': panel.key === 'wiring' }]} href={link(`projects/${panel.slug}/`)}>进入完整体验 <span aria-hidden="true">↗</span></a></div>
  </div>)}
</section>
<script>import '../experiences/load';</script>
