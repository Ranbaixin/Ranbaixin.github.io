---
import content from '../data/content.json';
import { withBase } from '../lib/model.mjs';
import '../styles/global.css';
interface Props { title?: string; description?: string; resume?: boolean; }
const { title = `${content.profile.name} · 数据科学与工程自动化实践`, description = content.profile.intro, resume = false } = Astro.props;
const link = (path = '') => withBase(import.meta.env.BASE_URL, path);
const canonical = new URL(Astro.url.pathname, Astro.site);
const icpNumber = import.meta.env.PUBLIC_ICP_NUMBER;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f8ff" />
    <link rel="icon" type="image/svg+xml" href={link('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('xyc-theme');
        document.documentElement.dataset.theme = theme || 'system';
        if (localStorage.getItem('xyc-motion') === 'reduce') document.documentElement.dataset.motion = 'reduce';
      } catch {}
    </script>
  </head>
  <body id="top" class:list={[{ 'resume-view': resume }]}>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header wrap">
      <a class="brand" href={link()} aria-label={`${content.profile.name}，首页`}><span class="brand-mark">x<span>y</span>c<span class="brand-dot">.</span></span><span class="brand-name">{content.profile.name}</span></a>
      <nav aria-label="主导航">
        <a href={link('#about')}>关于</a><a href={link('#projects')}>项目</a><a href={link('#journey')}>经历</a><a href={link('#honors')}>荣誉</a><a href={link('#contact')}>联系</a>
      </nav>
      <div class="header-tools">
        <button type="button" class="icon-button" data-theme-toggle hidden aria-label="切换深浅主题" title="切换深浅主题"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
        <a class="header-resume" href={link('resume/')}>我的简历 <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="brand-mark" href={link()} aria-label="回到首页">xyc<span class="brand-dot">.</span></a><p>保持好奇，持续实践。</p></div>
      <div class="footer-meta"><span>© {new Date().getFullYear()} {content.profile.name}</span><span>{content.profile.location}</span>{icpNumber && <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{icpNumber}</a>}<button type="button" class="text-button" data-motion-toggle hidden aria-pressed="false">减少动画</button><a href="#top">回到顶部 ↑</a></div>
    </footer>
    <script>import '../scripts/ui';</script>
  </body>
</html>
