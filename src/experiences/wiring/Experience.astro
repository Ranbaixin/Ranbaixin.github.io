---
import { wiringSample, queryConnections } from './model.mjs';
import Sheet from './Sheet.astro';
import '../../styles/wiring.css';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const result = queryConnections(wiringSample, 'p1', 'direct');
const endpoint = (id: string) => wiringSample.ports.find(p => p.id === id)!;
---
<section class="experience experience-wiring" data-experience="wiring-query" data-variant={compact ? 'compact' : 'full'} aria-label="端口查询交互体验">
  <div class="experience-topline"><span class="demo-label">图纸关系脱敏重绘 / ENGINEERING ATLAS</span><button class="reset-button" data-demo-reset hidden type="button">重置体验 ↺</button></div>
  <div class="experience-layout">
    <div class="demo-visual">
      <div class="visual-heading"><span>从开关出线，找到端子排的对应行。</span><span class="mono">REFERENCE → EVIDENCE</span></div>
      <div class="drawing-toolbar" data-drawing-toolbar hidden><div class="drawing-pages" role="group" aria-label="选择图页">{wiringSample.pages.map((page, i) => <button type="button" data-sheet-button={page.id} aria-pressed={i === 0}>{page.id} · {i === 0 ? '接线' : '端子排'}</button>)}</div><div class="drawing-zoom" role="group" aria-label="图纸缩放"><button type="button" data-drawing-zoom="out" aria-label="缩小图纸">−</button><button type="button" data-drawing-zoom="fit" aria-label="显示整页">整页</button><button type="button" data-drawing-zoom="in" aria-label="放大图纸">＋</button></div></div>
      <p class="drawing-page-status" data-page-status>P01 馈线开关接线 / P02 端子排对照</p>
      <div class="drawing-viewport" data-drawing-viewport>{wiringSample.pages.map(page => <Sheet page={page.id}/>)}</div>
      <p class="drawing-instruction"><span data-input-hint="generic">静态图纸样例：对照接线页与端子排，阅读下方连接说明。</span><span data-input-hint="controls">选择端口或“查看依据”定位；使用缩放按钮调整图面。</span><span data-input-hint="touch">点按端口或“查看依据”定位；使用缩放按钮，放大后可单指拖动图面。</span><span data-input-hint="pointer">点击端口或“查看依据”定位；放大后可拖动，方向键移动图面，＋／− 缩放。</span></p>
      <div class="object-caption"><span class="status-dot"></span><span data-wiring-selection>Q01:2 · P01 · 馈线开关出线端</span></div>
    </div>
    <aside class="demo-controls" data-demo-controls hidden aria-label="端口查询控件">
      <label data-full-only>搜索端口<input data-port-search type="search" aria-label="搜索端口" placeholder="例如 Q01、XT01、95" autocomplete="off" maxlength="40"/></label>
      <div class="port-list" data-port-list aria-label="匹配端口" data-full-only></div><p class="port-search-hint" data-search-count data-full-only>输入器件或端子代号定位</p>
      <label>追线起点<select data-trace-source aria-label="追线起点">{wiringSample.ports.map(port => <option value={port.id}>{port.label} · 页 {port.page}</option>)}</select></label>
      <label>追线目标<select data-trace-target aria-label="追线目标">{wiringSample.ports.map(port => <option value={port.id} selected={port.id === 'p4'}>{port.label} · 页 {port.page}</option>)}</select></label>
      <button class="trace-button" data-trace-start type="button">追踪已确认连接 <span aria-hidden="true">↗</span></button>
      <div class="control-divider" data-full-only></div>
      <p class="control-eyebrow" data-full-only>选择查询范围</p>
      <div class="query-modes" role="group" aria-label="连接查询范围" data-full-only><button data-wiring-mode="direct" aria-pressed="true" type="button">直接连接</button><button data-wiring-mode="network" aria-pressed="false" type="button">已确认网络</button><button data-wiring-mode="pending" aria-pressed="false" type="button">待核信息</button></div>
      <p class="control-hint" data-query-hint data-full-only>直接连接展示已核对双端引用的对应端。</p>
    </aside>
    <div class="demo-results">
      <p class="trace-summary" data-trace-summary aria-live="polite">点击图中端口作为起点，再选择目标追线。</p>
      <div class="query-result-heading" data-full-only><h3 data-wiring-result-title>Q01:2 的直接连接</h3><span class="mono" data-wiring-count>01 RELATION</span></div>
      <div class="connection-results" data-wiring-results aria-live="polite" data-full-only>{result.edges.map(edge => <article class="connection-row"><strong>{endpoint(edge.a).label} ↔ {endpoint(edge.b).label}</strong><span>双端对应</span><span>{edge.evidence}</span></article>)}</div>
      <div class="evidence-box" data-evidence tabindex="-1" data-full-only><span class="control-eyebrow">双端图纸依据</span><p>选择“查看依据”，对照接线页的去向标注与端子排的来源行。</p></div>
      <details class="method-details" data-full-only><summary>公开样例与资料处理</summary><p>{wiringSample.disclosure}</p><p>四组双端引用保留已核对关系；指示支路待核、辅助触点同网和器件内部边界分别记录。线材参数未公开，材质与颜色不补填。图面用于了解项目的查询与核对方式。</p></details>
    </div>
  </div>
</section>
