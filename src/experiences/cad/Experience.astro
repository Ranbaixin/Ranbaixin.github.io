---
import { createDrawingSample, createInventory } from './model.mjs';
const records = createDrawingSample();
const inventory = createInventory();
---
<section class="experience experience-cad" data-experience="cad-flow" aria-label="图纸流程交互体验">
  <div class="experience-topline"><span class="demo-label">重建样例 / CAD WORKFLOW</span><button class="reset-button" data-demo-reset hidden type="button">重置体验 ↺</button></div>
  <div class="experience-layout">
    <div class="demo-visual">
      <div class="visual-heading"><span>一张图纸，三个对象。</span><span class="mono" data-cad-count>03 PARTS</span></div>
      <svg class="cad-canvas" viewBox="0 0 720 470" role="group" aria-label="重新绘制的三块余料，启用脚本后可选择查看字段">
        <defs><pattern id="cad-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" class="demo-grid" fill="none"/></pattern></defs>
        <rect width="720" height="470" fill="url(#cad-grid)"/>
        <path d="M45 50V430H665" class="drawing-axis" fill="none"/>
        <text x="48" y="36" class="svg-note">REBUILT GEOMETRY / NOT TO SCALE</text>
        <g data-cad-shapes>{records.map((row, i) => <g class:list={['cad-part', { selected: i === 0 }]} data-cad-part={row.id}><polygon points={row.points}/><text x={row.center[0]} y={row.center[1]}>{row.partId}</text></g>)}</g>
        <text x="500" y="445" class="svg-note">每个轮廓，都关联一条记录</text>
      </svg>
      <div class="object-caption"><span class="status-dot"></span><span data-cad-selection>DEMO-01 · Q235B · 8 mm</span></div>
    </div>
    <aside class="demo-controls" data-demo-controls hidden aria-label="图纸处理控件">
      <label>图纸场景<select data-cad-scenario aria-label="图纸场景"><option value="complete">完整字段</option><option value="missing">字段缺失</option><option value="duplicate">重复记录</option></select></label>
      <div class="control-divider"></div>
      <p class="control-eyebrow">01 / 查看与校验</p>
      <form data-cad-form class="field-form">
        <label>材料<select name="material" aria-label="对象材料"><option value="">待补充</option><option selected>Q235B</option><option>Q355B</option></select></label>
        <label>厚度 / mm<input name="thickness" aria-label="对象厚度" type="number" min="0.1" max="200" step="0.1" value="8" required/></label>
        <button type="submit" class="small-button">保存对象字段</button>
      </form>
      <div class="repair-actions"><button type="button" class="small-button" data-cad-repair hidden>补入示例字段</button><button type="button" class="small-button" data-cad-dedupe hidden>移除重复记录</button></div>
      <div class="control-divider"></div>
      <p class="control-eyebrow">02 / 推进数据流转</p>
      <ol class="flow-steps" data-cad-steps><li aria-current="step">校验</li><li>转换</li><li>交接</li><li>入库</li></ol>
      <button type="button" class="button button-primary flow-next" data-cad-next>校验并继续</button>
    </aside>
    <div class="demo-results">
      <p class="demo-status" data-cad-status role="status">完整样例包含 3 条有效记录。选择一个对象，查看字段如何进入后续流程。</p>
      <details class="handoff-details"><summary>查看交接结构</summary><pre data-handoff>完成“转换数据”后，这里会显示交接字段。</pre></details>
      <div class="inventory-heading"><div><span class="control-eyebrow">03 / 样例余料库</span><h3>让状态，跟着操作走。</h3></div><div class="inventory-filters" data-inventory-filters hidden><label>材料筛选<select aria-label="材料筛选" data-stock-material><option value="all">全部材料</option><option>Q235B</option><option>Q355B</option></select></label><label>厚度筛选<select aria-label="厚度筛选" data-stock-thickness><option value="all">全部厚度</option><option value="8">8 mm</option><option value="12">12 mm</option></select></label></div></div>
      <div class="inventory-list" data-stock-list>{inventory.map(row => <article class="stock-row"><strong>{row.partId}</strong><span>{row.material} · {row.thickness} mm</span><span class="state-chip">{row.status === 'available' ? '可用' : '已预留'}</span></article>)}</div>
      <p class="quiet-note">浏览器中的校验与状态会真实变化；软件交接以字段转换示例呈现。</p>
    </div>
  </div>
</section>
