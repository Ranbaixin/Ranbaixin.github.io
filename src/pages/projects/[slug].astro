---
import Base from '../../layouts/Base.astro';
import CadExperience from '../../experiences/cad/Experience.astro';
import SplitExperience from '../../experiences/splitting/Experience.astro';
import EnergyExperience from '../../experiences/energy/Experience.astro';
import WiringExperience from '../../experiences/wiring/Experience.astro';
import content from '../../data/content.json';
import { withBase } from '../../lib/model.mjs';
import '../../styles/experiences.css';
import '../../styles/workbenches.css';
export function getStaticPaths() { return content.projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const link = (path = '') => withBase(import.meta.env.BASE_URL, path);
const next = content.projects[(content.projects.findIndex(p => p.slug === project.slug) + 1) % content.projects.length];
const prompts: Record<string, string> = {
  'plate-split': '把一根构件拆成板件，再核对展开与余量。',
  'cad-flow': '选一张图，看看信息怎样流向下一步。',
  'output-forecast': '从气象输入出发，比较出力与误差。',
  'wiring-query': '点一个端口，跨页追踪连接与图纸依据。',
};
---
<Base title={`${project.title} · ${content.profile.nicknameEn}`} description={project.summary}>
  <article class="case-page case-interactive wrap">
    <a class="back-link" href={link('#projects')}>← 返回项目列表</a>
    <header class="case-heading"><div><p class="case-kicker mono">PROJECT {project.number} / {project.categoryLabel}</p><h1>{project.title}</h1><p class="case-invitation">{prompts[project.demo.type]}</p></div><div class="case-date"><span>{project.period}</span><span>{project.role}</span></div></header>
    <div class="case-tabs" data-case-tabs role="tablist" aria-label="项目内容" hidden>
      <button role="tab" id="tab-experience" aria-controls="panel-experience" aria-selected="true" data-case-tab="experience" type="button">交互体验 <span>01</span></button>
      <button role="tab" id="tab-role" aria-controls="panel-role" aria-selected="false" data-case-tab="role" tabindex="-1" type="button">我的职责 <span>02</span></button>
      <button role="tab" id="tab-outcomes" aria-controls="panel-outcomes" aria-selected="false" data-case-tab="outcomes" tabindex="-1" type="button">成果与收获 <span>03</span></button>
    </div>
    <section id="panel-experience" data-case-panel="experience" role="tabpanel" aria-labelledby="tab-experience" tabindex="0">
      <noscript><p class="no-script-note">当前显示静态样例与结果。启用 JavaScript 后，可操作场景、筛选和查询；下方仍可完整阅读职责与成果。</p></noscript>
      {project.demo.type === 'cad-flow' && <CadExperience />}
      {project.demo.type === 'plate-split' && <><SplitExperience /><details class="secondary-experience"><summary>查看我参与的预处理与余料库体验</summary><CadExperience /></details></>}
      {project.demo.type === 'output-forecast' && <EnergyExperience />}
      {project.demo.type === 'wiring-query' && <WiringExperience />}
      <p data-experience-error class="no-script-note" hidden>交互资源暂未加载，静态样例仍可阅读。刷新后可重试。</p>
    </section>
    <section id="panel-role" class="case-reading" data-case-panel="role" role="tabpanel" aria-labelledby="tab-role" tabindex="0">
      <div class="reading-heading"><span class="control-eyebrow">MY CONTRIBUTION</span><h2>我负责的部分</h2><p>{project.role} · {project.period}</p></div>
      <div class="reading-content"><ul class="responsibility-list">{project.responsibilities.map((item, index) => <li><span class="mono">0{index + 1}</span><p>{item}</p></li>)}</ul><details class="method-details"><summary>项目背景与技术方法</summary><p>{project.background}</p><div class="project-tags">{project.methods.map(method => <span>{method}</span>)}</div></details></div>
    </section>
    <section id="panel-outcomes" class="case-reading" data-case-panel="outcomes" role="tabpanel" aria-labelledby="tab-outcomes" tabindex="0">
      <div class="reading-heading"><span class="control-eyebrow">OUTPUT & REFLECTION</span><h2>成果与收获</h2><p>个人工作与团队产出分别记录。</p></div>
      <div class="reading-content"><h3>团队的阶段产出</h3><ul>{project.outcomes.map(item => <li>{item}</li>)}</ul><details class="method-details" open><summary>做到哪里，如何看待结果</summary><p>{project.verification}</p></details><blockquote class="project-reflection"><span>实践收获</span><p>{project.reflection}</p></blockquote></div>
    </section>
    <a class="next-project" href={link(`projects/${next.slug}/`)}><div><span class="mono">NEXT EXPERIENCE</span><h2>{next.title}</h2></div><span aria-hidden="true">↗</span></a>
  </article>
  <script>import '../../experiences/load';</script>
</Base>
