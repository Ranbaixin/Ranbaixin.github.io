---
import Base from '../../layouts/Base.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import content from '../../data/content.json';
import { withBase } from '../../lib/model.mjs';
export function getStaticPaths() { return content.projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const link = (path = '') => withBase(import.meta.env.BASE_URL, path);
const next = content.projects[(content.projects.findIndex(p => p.slug === project.slug) + 1) % content.projects.length];
---
<Base title={`${project.title} · 肖逸辰`} description={project.summary}>
  <article class="case-page wrap"><a class="back-link" href={link('#projects')}>← 返回项目列表</a><div class="case-kicker mono">PROJECT {project.number} / {project.categoryLabel}</div><h1>{project.title}</h1><p class="case-lead">{project.summary}</p><dl class="case-meta"><div><dt>参与时间</dt><dd>{project.period}</dd></div><div><dt>我的职责</dt><dd>{project.role}</dd></div><div><dt>项目状态</dt><dd>持续推进 · 阶段验证</dd></div></dl><ProjectArt theme={project.theme}/>
    <div class="case-body"><section><span class="section-number mono">01 / CONTEXT</span><div><h2>从什么问题出发</h2><p>{project.background}</p></div></section><section><span class="section-number mono">02 / MY ROLE</span><div><h2>我负责的部分</h2><ul>{project.responsibilities.map(item => <li>{item}</li>)}</ul></div></section><section><span class="section-number mono">03 / TEAM OUTPUT</span><div><h2>团队的阶段产出</h2><ul>{project.outcomes.map(item => <li>{item}</li>)}</ul><div class="project-tags">{project.methods.map(method => <span>{method}</span>)}</div></div></section><section><span class="section-number mono">04 / VALIDATION</span><div><h2>做到哪里，如何看待结果</h2><p>{project.verification}</p></div></section><section class="case-reflection"><span class="section-number mono">05 / REFLECTION</span><div><h2>留下的理解</h2><p>{project.reflection}</p></div></section></div>
    <a class="next-project" href={link(`projects/${next.slug}/`)}><div><span class="mono">NEXT PROJECT</span><h2>{next.title}</h2></div><span aria-hidden="true">↗</span></a>
  </article>
</Base>
