---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/model.mjs';
import content from '../data/content.json';
---
<Base title={`页面未找到 · ${content.profile.nicknameEn}`}><section class="not-found wrap"><span class="mono">404 / NOT FOUND</span><h1>这个坐标，<br/>暂时没有内容。</h1><p>链接可能已经变化，回到首页继续探索。</p><a class="button button-primary" href={withBase(import.meta.env.BASE_URL, '')}>返回首页 ↗</a></section></Base>
