# PORTFOLIO_DOMAIN must be the approved, verified domain before public activation.
{$PORTFOLIO_DOMAIN} {
    root * /srv/portfolio/current
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    @immutable path /_astro/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @document path / /resume/ /projects/* /release.json /404.html
    header @document Cache-Control "no-cache"
    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
